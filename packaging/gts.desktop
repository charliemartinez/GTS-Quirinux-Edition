[Desktop Entry]

Name=GTS (Ghibli Tracing System)
Comment=Scan drawings for animation
Comment[de]=Zeichnungen für Animationen einscannen
Comment[es]=Escanear dibujos para animación
Comment[gl]=Escanear debuxos para animación
Comment[fr]=Numériser des dessins pour l'animation
Comment[pt]=Digitalizar desenhos para animação
Comment[it]=Scansiona disegni per l'animazione
Comment[hu]=Rajzok beolvasása animációhoz
Comment[ru]=Сканирование рисунков для анимации

Keywords[de]=scan;einlesen;scanner;Flachbett;flatbed;AVW;Vorlagenwechsler;adf;
Keywords[es]=escanear;escáner;plano;adf;
Keywords[fr]=numériser;scanner;numériseur;à plat;adf;
Keywords[gl]=escanear;escáner;flatbed;adf;
Keywords[hu]=szkennelés;szkenner;beolvasó;síkágyas;adf;
Keywords[it]=scan;scanner;scansiona;adf;acquisizione;
Keywords[pt]=digitalizar;digitalizador;tabuleiro de documentos;adf;
Keywords[ru]=сканировать;сканер;планшетный;автоподатчик;
Keywords=scan;scanner;flatbed;adf;

Exec=gts
TryExec=gts

Icon=gts
Terminal=false
Type=Application
StartupNotify=true
Categories=Graphics;Scanning;Escaneo;
